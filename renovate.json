{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "docker:pinDigests",
    ":disableRateLimiting"
  ],
  "hostRules": [
    {
      "matchHost": "juicedata.github.io",
      "hostType": "helm"
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Helm charts in ArgoCD Applications",
      "managerFilePatterns": [
        "/\\.ya?ml$/"
      ],
      "matchStrings": [
        "repoURL:\\s*(?<registryUrl>https?://[^\\s]+)\\s+chart:\\s*(?<depName>[^\\s]+)\\s+targetRevision:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+[^\\s]*)"
      ],
      "datasourceTemplate": "helm"
    }
  ],
  "packageRules": [
    {
      "description": "Ignore self-referential repo",
      "enabled": false,
      "matchPackageNames": [
        "/ApexAlpha/k8s-cluster/"
      ]
    },
    {
      "description": "Pin digests for all Docker images including latest",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Group LinuxServer.io images",
      "groupName": "linuxserver.io images",
      "matchPackageNames": [
        "/^lscr\\.io/linuxserver//"
      ]
    },
    {
      "description": "Group ArgoCD updates",
      "groupName": "argocd",
      "matchPackageNames": [
        "/^quay\\.io/argoproj//",
        "/argocd/"
      ]
    },
    {
      "description": "Don't automerge ArgoCD install changes",
      "matchFileNames": [
        "argocd-install/**"
      ],
      "automerge": false
    },
    {
      "description": "Schedule updates for weekends",
      "schedule": [
        "after 9am on saturday"
      ],
      "matchPackageNames": [
        "*"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "labels": [
    "dependencies",
    "renovate"
  ],
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "3 days"
}

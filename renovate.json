{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "docker:pinDigests",
    ":disableRateLimiting"
  ],
  "kubernetes": {
    "fileMatch": ["\\.ya?ml$"]
  },
  "argocd": {
    "fileMatch": ["\\.ya?ml$"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Helm charts in ArgoCD Applications",
      "fileMatch": ["\\.ya?ml$"],
      "matchStrings": [
        "repoURL:\\s*(?<registryUrl>https?://[^\\s]+)\\s+chart:\\s*(?<depName>[^\\s]+)\\s+targetRevision:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+[^\\s]*)"
      ],
      "datasourceTemplate": "helm"
    }
  ],
  "packageRules": [
    {
      "description": "Ignore self-referential repo",
      "matchPackagePatterns": ["ApexAlpha/k8s-cluster"],
      "enabled": false
    },
    {
      "description": "Pin digests for all Docker images including latest",
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Group LinuxServer.io images",
      "matchPackagePatterns": ["^lscr\\.io/linuxserver/"],
      "groupName": "linuxserver.io images"
    },
    {
      "description": "Group ArgoCD updates",
      "matchPackagePatterns": ["^quay\\.io/argoproj/", "argocd"],
      "groupName": "argocd"
    },
    {
      "description": "Automerge patch and minor for homelab apps",
      "matchFileNames": ["homelab/**"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "description": "Don't automerge ArgoCD install changes",
      "matchFileNames": ["argocd-install/**"],
      "automerge": false
    },
    {
      "description": "Schedule updates for weekends",
      "matchPackagePatterns": ["*"],
      "schedule": ["after 9am on saturday"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "labels": ["dependencies", "renovate"],
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10
}

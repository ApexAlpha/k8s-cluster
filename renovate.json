{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "docker:pinDigests",
    ":disableRateLimiting"
  ],
  "platformAutomerge": false,
  "hostRules": [
    {
      "matchHost": "juicedata.github.io",
      "hostType": "helm"
    },
    {
      "matchHost": "docker.io",
      "hostType": "docker",
      "username": "ApexAlpha",
      "encrypted": {
        "password": ""
      }
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Helm charts in ArgoCD Applications",
      "managerFilePatterns": [
        "/\\.ya?ml$/"
      ],
      "matchStrings": [
        "repoURL:\\\\s*(?<registryUrl>https?://[^\\\\s]+)\\\\s+chart:\\\\s*(?<depName>[^\\\\s]+)\\\\s+targetRevision:\\\\s*(?<currentValue>\\\\d+\\\\.\\\\d+\\\\.\\\\d+[^\\\\s]*)"
      ],
      "datasourceTemplate": "helm"
    }
  ],
  "packageRules": [
    {
      "description": "Ignore self-referential repo",
      "enabled": false,
      "matchPackageNames": [
        "/ApexAlpha/k8s-cluster/"
      ]
    },
    {
      "description": "Pin digests for all Docker images including latest",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Group LinuxServer.io images",
      "groupName": "linuxserver.io images",
      "matchPackageNames": [
        "/^lscr\\.io/linuxserver//"
      ]
    },
    {
      "description": "Group ArgoCD updates",
      "groupName": "argocd",
      "matchPackageNames": [
        "/^quay\\.io/argoproj//",
        "/argocd/"
      ]
    },
    {
      "description": "Automerge non-major updates between 00:00-01:00 UTC (before nightly backups)",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "automerge": true,
      "automergeSchedule": [
        "* 0 * * *"
      ],
      "rebaseWhen": "conflicted"
    },
    {
      "description": "Don't automerge ArgoCD install changes",
      "matchFileNames": [
        "argocd-install/**"
      ],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "minimumReleaseAge": "0 days"
  },
  "labels": [
    "dependencies",
    "renovate"
  ],
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "1 day"
}

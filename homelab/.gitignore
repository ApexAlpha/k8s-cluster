# Secrets - never commit these
*.secret
*.secret.yaml
*-secret.yaml

# BUT allow sealed secrets
!sealed-*.yaml
!*-sealed-secret.yaml

# Keep templates
!*.template

# Plain secret files (before sealing)
/tmp/

# Local development
.env
.env.*
*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# DO NOT COMMIT - Copy to secrets.yaml and fill in values
# Apply with: kubectl apply -f secrets.yaml
---
apiVersion: v1
kind: Secret
metadata:
  name: authelia-secrets
  namespace: authelia
type: Opaque
stringData:
  jwt_secret: "PASTE_JWT_SECRET"
  session_secret: "PASTE_SESSION_SECRET"
  storage_encryption_key: "PASTE_STORAGE_KEY"
  oidc_hmac_secret: "PASTE_OIDC_HMAC"
  oidc_jwks_key: |
    -----BEGIN RSA PRIVATE KEY-----
    PASTE_RSA_KEY_HERE
    -----END RSA PRIVATE KEY-----
---
apiVersion: v1
kind: Secret
metadata:
  name: authelia-users
  namespace: authelia
type: Opaque
stringData:
  users_database.yml: |
    users:
      jules:
        displayname: Jules
        email: jules@example.com
        password: "PASTE_ARGON2_HASH"
        groups:
          - admins
      gf:
        displayname: GF
        email: gf@example.com
        password: "PASTE_ARGON2_HASH"
        groups:
          - users
---
apiVersion: v1
kind: Secret
metadata:
  name: mealie-oidc
  namespace: mealie
type: Opaque
stringData:
  client_secret: "PASTE_MEALIE_CLIENT_SECRET"

# Vaultwarden Sealed Secrets
#
# Generate these sealed secrets using:
#
# 1. Database credentials:
#
#    cat > /tmp/vaultwarden-db.yaml << EOF
#    apiVersion: v1
#    kind: Secret
#    metadata:
#      name: vaultwarden-db-credentials
#      namespace: apps
#    type: Opaque
#    stringData:
#      uri: "postgresql://vaultwarden:YOUR_PASSWORD@main-db-rw.databases.svc:5432/vaultwarden"
#    EOF
#
#    kubeseal --controller-name=sealed-secrets-controller \
#             --controller-namespace=kube-system \
#             --format yaml \
#             < /tmp/vaultwarden-db.yaml \
#             > apps/vaultwarden/manifests/sealed-db-secret.yaml
#
# 2. Admin token (generate with: openssl rand -base64 48):
#
#    cat > /tmp/vaultwarden-admin.yaml << EOF
#    apiVersion: v1
#    kind: Secret
#    metadata:
#      name: vaultwarden-admin
#      namespace: apps
#    type: Opaque
#    stringData:
#      token: "YOUR_GENERATED_ADMIN_TOKEN"
#    EOF
#
#    kubeseal --controller-name=sealed-secrets-controller \
#             --controller-namespace=kube-system \
#             --format yaml \
#             < /tmp/vaultwarden-admin.yaml \
#             > apps/vaultwarden/manifests/sealed-admin-secret.yaml
#
# 3. Clean up plain secrets:
#    rm /tmp/vaultwarden-*.yaml
#
# 4. Commit sealed secrets to Git

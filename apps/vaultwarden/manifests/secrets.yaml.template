# NOTE: This is a TEMPLATE. Do not commit real secrets!
# Either:
# 1. Create secrets manually: kubectl create secret ...
# 2. Use Sealed Secrets or External Secrets Operator
# 3. Use SOPS encryption

---
# Database credentials (created by CNPG or manually)
# The CNPG operator will create this automatically when you
# add Vaultwarden as a database user
apiVersion: v1
kind: Secret
metadata:
  name: vaultwarden-db-credentials
  namespace: apps
type: Opaque
stringData:
  # Format: postgresql://user:password@host:port/database
  uri: "postgresql://vaultwarden:CHANGE_ME@main-db-rw.databases.svc:5432/vaultwarden"

---
# Admin token for Vaultwarden admin panel
# Generate with: openssl rand -base64 48
apiVersion: v1
kind: Secret
metadata:
  name: vaultwarden-admin
  namespace: apps
type: Opaque
stringData:
  token: "CHANGE_ME_GENERATE_SECURE_TOKEN"
